# Anthropic. ANTHROPIC_KEY_EXPIRES (YYYY-MM-DD) makes GET /status warn 30 days before the key expires.
ANTHROPIC_API_KEY=
ANTHROPIC_KEY_EXPIRES=

# Supabase (service role key: the agent writes config + logs)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gmail (OAuth client for the success@ mailbox; refresh token from a one-time consent flow)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=success@nrnglobal.ca

# Clients sheet (source of truth for agent_clients). ID is the long string in the sheet URL.
# The refresh token above needs the spreadsheets.readonly scope; share the sheet with GMAIL_USER.
CLIENTS_SHEET_ID=
CLIENTS_SHEET_TAB=Account list

# Asana personal access token (service user or Neil)
ASANA_PAT=
ASANA_WORKSPACE_GID=
ASANA_AGENT_INBOX_PROJECT_GID=

# Slack app (bot token with chat:write, channels:history; signing secret for events)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_AGENT_CHANNEL_ID=
SLACK_NEIL_USER_ID=
# Optional. App-level token (xapp-…, scope connections:write) enables Socket Mode so no public Request URL is needed.
SLACK_APP_TOKEN=

# Shared secret pg_cron sends in the X-Run-Token header
RUN_TOKEN=

# Separate read-only secret for GET /status (X-Status-Token). Never reuse RUN_TOKEN here.
STATUS_TOKEN=

PORT=3000
